# Domain from APP_DOMAIN (the .env file next to compose.yaml). Caddy obtains and renews the
# Let's Encrypt certificate itself and sets X-Forwarded-Proto/Host/For - Spring (prod profile) builds https:// addresses from them.
{$APP_DOMAIN} {
	reverse_proxy app:8080 {
		# Spring also honours these headers and Caddy does not overwrite them - we strip the client's values
		header_up -Forwarded
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Port
	}
}
