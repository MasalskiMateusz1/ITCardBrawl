# Rotation of Docker container logs (app, caddy): daily, kept for 30 days.
# Docker (json-file driver) rotates only by size, so the host's logrotate does time-based rotation.
# Installation: /etc/logrotate.d/docker-containers (see deploy/README.md, section 1).
/var/lib/docker/containers/*/*-json.log {
	daily
	rotate 30
	maxage 30
	missingok
	notifempty
	compress
	delaycompress
	dateext
	# Docker keeps the file open - we copy and truncate in place instead of moving it
	copytruncate
}
