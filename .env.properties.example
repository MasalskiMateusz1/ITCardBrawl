# Copy to .env.properties (repository root, git-ignored file) and fill in.
# Environment variables with the same names take precedence.
#
# Callbacks to register with the providers (dev, through the ng serve proxy):
#   GitHub: http://localhost:4200/login/oauth2/code/github
#   Google: http://localhost:4200/login/oauth2/code/google
#
# Production uses separate OAuth apps (callbacks https://<domain>/...) and secrets
# in app.env on the server, not this file - see deploy/README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
