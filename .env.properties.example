# Skopiuj do .env.properties (katalog glowny repozytorium, plik git-ignorowany) i uzupelnij.
# Zmienne srodowiskowe o tych samych nazwach maja wyzszy priorytet.
#
# Callbacki do zarejestrowania u dostawcow (dev, przez proxy ng serve):
#   GitHub: http://localhost:4200/login/oauth2/code/github
#   Google: http://localhost:4200/login/oauth2/code/google
#
# Produkcja uzywa osobnych aplikacji OAuth (callbacki https://<domena>/...) i sekretow
# w app.env na serwerze, nie tego pliku - zob. deploy/README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
